# Copy to .env and fill in the cyber_app password you set with \password.
# .env is ignored by git; never commit real passwords.
# Special characters in the password must be URL-encoded: @ -> %40, : -> %3A, / -> %2F, # -> %23, % -> %25.
DATABASE_URL=postgresql+psycopg://cyber_app:CHANGE_ME@127.0.0.1:5433/cyber_risk_intelligence
TEST_DATABASE_URL=postgresql+psycopg://cyber_app:CHANGE_ME@127.0.0.1:5433/cyber_risk_test

# Evidence storage. Without MINIO_ENDPOINT, originals go to EVIDENCE_DIR (default ./evidence).
# EVIDENCE_DIR=evidence
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_ACCESS_KEY=cyber-evidence
# MINIO_SECRET_KEY=CHANGE_ME
# MINIO_SECURE=false
# EVIDENCE_BUCKET=evidence

# Collectors identify themselves with this User-Agent. Include a way to contact you.
# COLLECTOR_USER_AGENT=cyber-risk-research/0.1 (contact: you@example.com)
